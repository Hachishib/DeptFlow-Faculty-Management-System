{
  "compilerOptions": {
    "target": "ES2020", // modern JS target
    "module": "CommonJS", // Node.js modules
    "rootDir": "src", // source files are in src/
    "outDir": "dist", // compiled JS goes to dist/
    "esModuleInterop": true, // allow default imports
    "strict": true, // enable strict type checking
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*"]
}
